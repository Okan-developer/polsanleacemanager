#!/bin/sh
# dotnet-step — runs one dotnet command for scripts/check.conf with resource hygiene applied
# (docs/testing.md, Resource hygiene). Usage: sh scripts/dotnet-step <dotnet args...>
# Greenfield guard: until the first .NET project or solution exists, the step is a no-op that says
# so. As soon as any *.csproj / *.sln / *.slnx is in the tree the guard is gone for good and the
# command must succeed — there is no way to skip a step once code exists.
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if ! find "$ROOT" -path "$ROOT/.git" -prune -o \( -name '*.csproj' -o -name '*.sln' -o -name '*.slnx' \) -print 2>/dev/null | grep -q .; then
  echo "dotnet-step: no .NET project yet — greenfield, skipped: dotnet $*"
  exit 0
fi
# resource hygiene: no MSBuild worker nodes left alive after the build (node reuse off)
export MSBUILDDISABLENODEREUSE=1
# resource hygiene: no MSBuild server process
export DOTNET_CLI_USE_MSBUILD_SERVER=0
# resource hygiene: no Roslyn compiler server (VBCSCompiler); MSBuild reads env vars as properties
export UseSharedCompilation=false
# resource hygiene: no Razor build server (rzc) for the Blazor project
export UseRazorBuildServer=false
export DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1
cd "$ROOT" && exec dotnet "$@"
